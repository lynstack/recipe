{
  "$schema": "../../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../../.oxlintrc.json"],
  "overrides": [
    {
      // Its helpers leave their return types to tsc, as the libraries that
      // this checks the declarations of write them.
      "files": ["inferred.ts"],
      "rules": {
        "typescript/explicit-function-return-type": "off",
        "typescript/explicit-module-boundary-types": "off"
      }
    }
  ],
  "rules": {
    // React Native does not type its styles as read-only, so a function
    // of an app that takes them cannot take read-only types.
    "typescript/prefer-readonly-parameter-types": "off"
  }
}
