{
  "name": "native-recipe-library-isolated",
  "version": "1.0.0",
  "private": true,
  "description": "A library that installs @lynstack/native-recipe and emits each file's declarations on its own, with isolatedDeclarations, as oxc and tsdown do.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./out/index.d.ts"
    }
  },
  "files": [
    "out"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.strictest.json && oxlint"
  },
  "dependencies": {
    "@lynstack/native-recipe": "workspace:^",
    "react": "19.3.0",
    "react-native": "0.87.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  }
}
