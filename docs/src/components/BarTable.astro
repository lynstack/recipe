---
import type { BarGroup } from "../measurements/bars.ts";
import { barSectionOf } from "../measurements/bars.ts";

interface Props {
  readonly title: string;
  readonly groups: readonly BarGroup[];
}

const { title, groups } = Astro.props;
const sections = groups.map((group) => barSectionOf(group));
---

<div
  class="bars-wrap"
  tabindex="0"
  role="region"
  aria-label={`${title} benchmark`}
>
  <table class="bars">
    <caption class="sr-only">{`${title} benchmark`}</caption>
    <thead>
      <tr>
        <th scope="col">{title}</th>
        <th scope="col" class="bar-cell">
          <span class="sr-only">Relative to the fastest of its group</span>
        </th>
        <th scope="col" class="number">
          Calls/s
        </th>
        <th scope="col" class="number">
          Compared
        </th>
      </tr>
    </thead>
    {sections.map((section) => (
      <tbody>
        {section.heading !== undefined && (
          <tr>
            <th class="group-head" scope="rowgroup" colspan="4">
              {section.heading}
            </th>
          </tr>
        )}
        {section.lines.map((line) => (
          <tr class:list={{ "bar-subject": line.subject }}>
            <td>{line.subject ? <strong>{line.label}</strong> : line.label}</td>
            <td class="bar-cell">
              <div
                class="bar"
                role="img"
                aria-label={`${Math.round(line.percent)}% of the fastest`}
              >
                <span style={`width: ${line.percent.toFixed(1)}%`} />
              </div>
            </td>
            <td class="number">{line.speed}</td>
            <td class="number relative">{line.relative ?? "—"}</td>
          </tr>
        ))}
      </tbody>
    ))}
  </table>
</div>
