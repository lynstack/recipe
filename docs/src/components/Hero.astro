---
import { Code } from "@astrojs/starlight/components";
import Default from "@astrojs/starlight/components/Hero.astro";
import { exampleOf } from "../examples/examples.ts";
import { formatCall } from "../examples/format.ts";
import { sourceOf } from "../examples/sources.ts";

const name = "class-recipe/index/button";
const call = { tone: "danger" };
const [result] = exampleOf(name).valuesOf(call);
const example = `${sourceOf(name)}
${formatCall("button", call).text};
// => ${JSON.stringify(result?.value)}`;
---

<div class="landing-hero">
  <div class="landing-hero-copy">
    <p class="landing-eyebrow not-content">lynstack recipe</p>
    <Default />
    <div class="landing-install not-content">
      <Code code="npm install @lynstack/class-recipe" lang="sh" frame="none" />
    </div>
  </div>
  <div class="landing-hero-example not-content">
    <Code code={example} lang="ts" title="button.ts" />
  </div>
</div>
