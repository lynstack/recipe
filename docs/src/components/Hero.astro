---
import { Code } from "@astrojs/starlight/components";
import Default from "@astrojs/starlight/components/Hero.astro";

const example = `import { cva } from "@lynstack/class-recipe";

const button = cva({
  base: "rounded-md",
  variants: {
    tone: {
      neutral: "bg-gray-100 text-gray-900",
      danger: "bg-red-600 text-white",
    },
    size: { sm: "h-8 px-3", md: "h-10 px-4" },
  },
  defaultVariants: { size: "md" },
});

button({ tone: "danger" });
// => "rounded-md bg-red-600 text-white h-10 px-4"`;
---

<div class="landing-hero">
  <div class="landing-hero-copy">
    <p class="landing-eyebrow not-content">lynstack recipe</p>
    <Default />
    <div class="landing-install not-content">
      <Code code="npm install @lynstack/class-recipe" lang="sh" frame="none" />
    </div>
  </div>
  <div class="landing-hero-example not-content">
    <Code code={example} lang="ts" title="button.ts" />
  </div>
</div>
