---
import Icon from "./Icon.astro";
import { linkIcons } from "../icons.ts";
import { packages } from "../packages.ts";
import { typeScriptVersion } from "../requirements.ts";

interface Props {
  readonly folder: keyof typeof packages;
}

const pkg = packages[Astro.props.folder];
const links = [
  { href: pkg.npm, icon: linkIcons.npm, label: "npm" },
  { href: pkg.changelog, icon: linkIcons.changelog, label: "Changelog" },
  { href: pkg.source, icon: linkIcons.source, label: "Source" },
];
---

<div class="package-meta not-content">
  <p class="package-meta-facts">
    <span>v{pkg.version}</span>
    <a href={pkg.requirements}>TypeScript {typeScriptVersion}+</a>
  </p>
  <ul class="package-meta-links" aria-label={`${pkg.name} links`}>
    {links.map((link) => (
      <li>
        <a href={link.href}>
          <Icon paths={link.icon} />
          {link.label}
        </a>
      </li>
    ))}
  </ul>
  <a class="package-meta-run" href={pkg.exampleApp.url}>
    <Icon paths={linkIcons.run} />
    Open in {pkg.exampleApp.host}
  </a>
</div>
