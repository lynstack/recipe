---
import type { IconPaths } from "../icons.ts";

interface Props {
  readonly paths: IconPaths;
}

const { paths } = Astro.props;
---

<svg
  class="icon"
  xmlns="http://www.w3.org/2000/svg"
  width="16"
  height="16"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {paths.map((d) => (
    <path {d} />
  ))}
</svg>
