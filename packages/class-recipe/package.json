{
  "name": "@lynstack/class-recipe",
  "version": "1.7.0",
  "description": "Fast, type-safe class name recipes with variants, compound variants, and slots, plus a clsx-compatible cx.",
  "keywords": [
    "class",
    "classnames",
    "clsx",
    "cva",
    "recipe",
    "slots",
    "tailwind",
    "variants"
  ],
  "homepage": "https://lynstack.github.io/recipe/class-recipe/",
  "bugs": "https://github.com/lynstack/recipe/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynstack/recipe.git",
    "directory": "packages/class-recipe"
  },
  "license": "MIT",
  "author": "Tim Phan",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@lynstack/recipe": "workspace:^"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "lint": "oxlint",
    "format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "pnpm build && vitest bench --run",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "class-variance-authority": "0.7.1",
    "classnames": "2.5.1",
    "clsx": "2.1.1",
    "fast-check": "4.10.2",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
