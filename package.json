{
  "name": "lynstack-recipe",
  "private": true,
  "description": "The @lynstack/recipe and @lynstack/class-recipe packages, and their docs.",
  "license": "MIT",
  "author": "Tim Phan",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "check": "pnpm -r check && pnpm typecheck && pnpm lint && pnpm format:check",
    "typecheck": "tsc -p scripts/tsconfig.json",
    "lint": "oxlint scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "bench": "pnpm -r --workspace-concurrency=1 bench",
    "measure": "pnpm build && node scripts/measure/main.ts",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "publint": "0.3.25",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.8.1"
}
